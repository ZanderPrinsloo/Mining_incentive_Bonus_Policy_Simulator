# Copy this file to .env and fill in the real values for this deployment.
# .env is gitignored — it's per-machine config, never committed.
#
# Connection details for the real Doornkop production/payroll database
# (SQL Server, business unit = Doornkop). Used only by the optional
# "Import from STPTM9000" feature on Doornkop-derived scenarios — the
# rest of the app works fine with this left unset.
#
# Uses Windows Trusted Authentication (no username/password needed) — the
# account running this app just needs read access to STPTM_DATABASE on
# STPTM_SQL_SERVER.

# SQL Server instance, e.g. MyServer\SQLEXPRESS or myserver.domain.local
STPTM_SQL_SERVER=

# Database name (usually doesn't need to change)
STPTM_DATABASE=STPTM9000

# Business unit code for Doornkop within that database (usually doesn't need to change)
STPTM_BUSSUNIT=RE
