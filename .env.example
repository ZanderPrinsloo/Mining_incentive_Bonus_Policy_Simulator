# Copy this file to .env and fill in the real values for this deployment.
# .env is gitignored — it's per-machine config, never committed.
#
# Connection details for the real Doornkop production/payroll database
# (SQL Server, business unit = Doornkop). Used only by the optional
# "Import from STPTM9000" feature on Doornkop-derived scenarios — the
# rest of the app works fine with this left unset.
#
# This file has no hardcoded server — the same code runs unchanged in
# either of these two setups:
#
#   Local development: point STPTM_SQL_SERVER at a restored copy of the
#   live database on your own machine, and leave STPTM_USERNAME/
#   STPTM_PASSWORD blank. Windows Trusted Authentication is used — your
#   own Windows login just needs read access to STPTM_DATABASE there.
#
#   Deployed on Harmony's server: point STPTM_SQL_SERVER at the real live
#   instance, and set STPTM_USERNAME/STPTM_PASSWORD to a SQL Server login
#   with read access — the account the app runs as on their server won't
#   necessarily have a trusted domain identity for the database the way a
#   developer's own workstation does. Setting STPTM_USERNAME is what
#   switches the connection from Trusted Auth to SQL Authentication;
#   leaving it blank keeps Trusted Auth.

# SQL Server instance, e.g. MyServer\SQLEXPRESS, myserver.domain.local, or
# a bare hostname (e.g. the real server's name on Harmony's network)
STPTM_SQL_SERVER=

# Database name (usually doesn't need to change)
STPTM_DATABASE=STPTM9000

# Business unit code for Doornkop within that database (usually doesn't need to change)
STPTM_BUSSUNIT=RE

# SQL Authentication — leave BOTH blank to use Windows Trusted Authentication
# instead (the local-development default). Only needed when the account
# running this app has no trusted domain identity for the database, e.g. a
# service account on Harmony's server.
STPTM_USERNAME=
STPTM_PASSWORD=

# ODBC driver name as installed on this machine — only change this if the
# deployment target has a different version installed (check with:
# python -c "import pyodbc; print(pyodbc.drivers())")
STPTM_DRIVER=ODBC Driver 18 for SQL Server
